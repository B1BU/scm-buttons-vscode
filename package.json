{
    "name": "scm-buttons-vscode-fork",
    "publisher": "b1bu",
    "version": "0.1.3",
    "description": "Additional Source Control Buttons for Visual Studio Code",
    "displayName": "Source Control Buttons (Fork)",
    "icon": "resources/icon.png",
    "main": "extension/extension.js",
    "repository": {
        "type": "github",
        "url": "https://github.com/b1bu/scm-buttons-vscode.git"
    },
    "scripts": {
        "build": "tsc -p .",
        "bundle": "npm run clean && npm run build && vsce package",
        "publish": "npm run bundle && vsce publish",
        "clean": "rm -f extension/*.js && rm -f extension/*.js.map && rm -f *.vsix"
    },
    "author": "b1bu@users.noreply.github.com",
    "license": "MIT",
    "categories": [
        "Other"
    ],
    "keywords": [
        "source",
        "control",
        "button",
        "scm",
        "git",
        "push",
        "pull",
        "commit",
        "stage",
        "checkout",
        "discard",
        "stash",
        "tree",
        "list"
    ],
    "engines": {
        "vscode": "^1.44.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "*"
    ],
    "contributes": {
        "configuration": [
            {
                "title": "Button Visibility",
                "description": "Buttons to show in source control pane",
                "properties": {
                    "scm-buttons.showGitCheckout": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.checkout`."
                    },
                    "scm-buttons.showGitSync": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.sync`."
                    },
                    "scm-buttons.showGitSyncRebase": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.syncRebase`."
                    },
                    "scm-buttons.showGitPull": {
                        "type": "boolean",
                        "default": true,
                        "markdownDescription": "Show button for command `git.pull`."
                    },
                    "scm-buttons.showGitPush": {
                        "type": "boolean",
                        "default": true,
                        "markdownDescription": "Show button for command `git.push`."
                    },
                    "scm-buttons.showGitPullRebase": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.pullRebase`."
                    },
                    "scm-buttons.showGitPushForce": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.pushForce`."
                    },
                    "scm-buttons.showGitPullFrom": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.pullFrom`."
                    },
                    "scm-buttons.showGitPushTo": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.pushTo`."
                    },
                    "scm-buttons.showGitPublish": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.publish`."
                    },
                    "scm-buttons.showGitCleanAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.cleanAll`."
                    },
                    "scm-buttons.showGitStageAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stageAll`."
                    },
                    "scm-buttons.showGitUnstageAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.unstageAll`."
                    },
                    "scm-buttons.showGitCommitStaged": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitStaged`."
                    },
                    "scm-buttons.showGitCommitAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitAll`."
                    },
                    "scm-buttons.showGitCommitStagedAmend": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitStagedAmend`."
                    },
                    "scm-buttons.showGitCommitAllAmend": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitAllAmend`."
                    },
                    "scm-buttons.showGitCommitStagedSigned": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitStagedSigned`."
                    },
                    "scm-buttons.showGitCommitAllSigned": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitAllSigned`."
                    },
                    "scm-buttons.showGitUndoCommit": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.undoCommit`."
                    },
                    "scm-buttons.showGitStashApplyLatest": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashApplyLatest`."
                    },
                    "scm-buttons.showGitStashApply": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashApply`."
                    },
                    "scm-buttons.showGitStashPopLatest": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashPopLatest`."
                    },
                    "scm-buttons.showGitStashPop": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashPop`."
                    },
                    "scm-buttons.showGitStash": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stash`."
                    },
                    "scm-buttons.showGitStashIncludeUntracked": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashIncludeUntracked`."
                    },
                    "scm-buttons.showGitStashStaged": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashStaged`."
                    },
                    "scm-buttons.showGitStashDrop": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashDrop`."
                    },
                    "scm-buttons.showGitShowOutput": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.showOutput`."
                    },
                    "scm-buttons.showGitRefresh": {
                        "type": "boolean",
                        "default": true,
                        "markdownDescription": "Show button for command `git.refresh`."
                    }
                }
            },
            {
                "title": "Debug",
                "properties": {
                    "scm-buttons.showAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show all buttons."
                    }
                }
            }
        ],
        "commands": [
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.checkout",
                "title": "Checkout to...",
                "icon": "$(git-commit)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.sync",
                "title": "Sync",
                "icon": "$(sync)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.syncRebase",
                "title": "Sync (Rebase)",
                "icon": "$(sync)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.pull",
                "title": "Pull",
                "icon": "$(repo-pull)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.push",
                "title": "Push",
                "icon": "$(repo-push)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.pullRebase",
                "title": "Pull (Rebase)",
                "icon": "$(repo-fetch)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.pushForce",
                "title": "Push (Force)",
                "icon": "$(repo-force-push)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.pullFrom",
                "title": "Pull from...",
                "icon": "$(cloud-download)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.pushTo",
                "title": "Push to...",
                "icon": "$(cloud-upload)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.publish",
                "title": "Publish branch...",
                "icon": "$(rocket)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.cleanAll",
                "title": "Discard All Changes",
                "icon": "$(discard)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stageAll",
                "title": "Stage All Changes",
                "icon": "$(add)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.unstageAll",
                "title": "Unstage All Changes",
                "icon": "$(remove)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.commitStaged",
                "title": "Commit Staged",
                "icon": "$(check)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.commitAll",
                "title": "Commit All",
                "icon": "$(check-all)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.commitStagedAmend",
                "title": "Commit Staged (Amend)",
                "icon": "$(check)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.commitAllAmend",
                "title": "Commit All (Amend)",
                "icon": "$(check-all)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.commitStagedSigned",
                "title": "Commit Staged (Signed Off)",
                "icon": "$(check)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.commitAllSigned",
                "title": "Commit All (Signed Off)",
                "icon": "$(check-all)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.undoCommit",
                "title": "Undo Commit",
                "icon": "$(reply)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stashApplyLatest",
                "title": "Apply Latest Stash",
                "icon": "$(git-stash-apply)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stashApply",
                "title": "Apply Stash...",
                "icon": "$(git-stash-apply)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stashPopLatest",
                "title": "Pop Latest Stash",
                "icon": "$(git-stash-pop)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stashPop",
                "title": "Pop Stash...",
                "icon": "$(git-stash-pop)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stash",
                "title": "Stash",
                "icon": "$(git-stash)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stashIncludeUntracked",
                "title": "Stash (Include Untracked)",
                "icon": "$(git-stash)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stashStaged",
                "title": "Stash Staged",
                "icon": "$(git-stash)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.stashDrop",
                "title": "Drop Stash...",
                "icon": "$(trash)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.showOutput",
                "title": "Show Git Output",
                "icon": "$(output)"
            },
            {
                "category": "Source Control Buttons",
                "command": "scm-buttons.git.refresh",
                "title": "Refresh",
                "icon": "$(refresh)"
            }
        ],
        "menus": {
            "scm/title": [
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitCheckout && scmProvider == git",
                    "command": "scm-buttons.git.checkout",
                    "group": "navigation@1"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitSync && scmProvider == git",
                    "command": "scm-buttons.git.sync",
                    "group": "navigation@2"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitSyncRebase && scmProvider == git",
                    "command": "scm-buttons.git.syncRebase",
                    "group": "navigation@3"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitPull && scmProvider == git",
                    "command": "scm-buttons.git.pull",
                    "group": "navigation@4"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitPush && scmProvider == git",
                    "command": "scm-buttons.git.push",
                    "group": "navigation@5"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitPullRebase && scmProvider == git",
                    "command": "scm-buttons.git.pullRebase",
                    "group": "navigation@6"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitPushForce && scmProvider == git",
                    "command": "scm-buttons.git.pushForce",
                    "group": "navigation@7"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitPullFrom && scmProvider == git",
                    "command": "scm-buttons.git.pullFrom",
                    "group": "navigation@8"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitPushTo && scmProvider == git",
                    "command": "scm-buttons.git.pushTo",
                    "group": "navigation@9"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitPublish && scmProvider == git",
                    "command": "scm-buttons.git.publish",
                    "group": "navigation@10"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitCleanAll && scmProvider == git",
                    "command": "scm-buttons.git.cleanAll",
                    "group": "navigation@11"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStageAll && scmProvider == git",
                    "command": "scm-buttons.git.stageAll",
                    "group": "navigation@12"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitUnstageAll && scmProvider == git",
                    "command": "scm-buttons.git.unstageAll",
                    "group": "navigation@13"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitCommitStaged && scmProvider == git",
                    "command": "scm-buttons.git.commitStaged",
                    "group": "navigation@14"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitCommitAll && scmProvider == git",
                    "command": "scm-buttons.git.commitAll",
                    "group": "navigation@15"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitCommitStagedAmend && scmProvider == git",
                    "command": "scm-buttons.git.commitStagedAmend",
                    "group": "navigation@16"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitCommitAllAmend && scmProvider == git",
                    "command": "scm-buttons.git.commitAllAmend",
                    "group": "navigation@17"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitCommitStagedSigned && scmProvider == git",
                    "command": "scm-buttons.git.commitStagedSigned",
                    "group": "navigation@18"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitCommitAllSigned && scmProvider == git",
                    "command": "scm-buttons.git.commitAllSigned",
                    "group": "navigation@19"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitUndoCommit && scmProvider == git",
                    "command": "scm-buttons.git.undoCommit",
                    "group": "navigation@20"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStashApplyLatest && scmProvider == git",
                    "command": "scm-buttons.git.stashApplyLatest",
                    "group": "navigation@21"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStashApply && scmProvider == git",
                    "command": "scm-buttons.git.stashApply",
                    "group": "navigation@22"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStashPopLatest && scmProvider == git",
                    "command": "scm-buttons.git.stashPopLatest",
                    "group": "navigation@23"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStashPop && scmProvider == git",
                    "command": "scm-buttons.git.stashPop",
                    "group": "navigation@24"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStash && scmProvider == git",
                    "command": "scm-buttons.git.stash",
                    "group": "navigation@25"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStashIncludeUntracked && scmProvider == git",
                    "command": "scm-buttons.git.stashIncludeUntracked",
                    "group": "navigation@26"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStashStaged && scmProvider == git",
                    "command": "scm-buttons.git.stashStaged",
                    "group": "navigation@27"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitStashDrop && scmProvider == git",
                    "command": "scm-buttons.git.stashDrop",
                    "group": "navigation@28"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitShowOutput && scmProvider == git",
                    "command": "scm-buttons.git.showOutput",
                    "group": "navigation@29"
                },
                {
                    "when": "config.scm-buttons.showAll && scmProvider == git || config.scm-buttons.showGitRefresh && scmProvider == git",
                    "command": "scm-buttons.git.refresh",
                    "group": "navigation@30"
                }
            ]
        }
    },
    "devDependencies": {
        "@types/vscode": "^1.44.0",
        "tslint": "^6.1.2",
        "tslint-eslint-rules": "^5.4.0",
        "typescript": "^3.9.7",
        "vsce": "^1.77.0"
    },
    "dependencies": {}
}