{
    "name": "more-scm-buttons",
    "publisher": "b1bu",
    "version": "1.0.0",
    "displayName": "More Source Control Buttons",
    "description": "Additional buttons for the Source Control panel",
    "icon": "resources/icon.png",
    "main": "extension/extension.js",
    "repository": {
        "type": "github",
        "url": "https://github.com/b1bu/scm-buttons-vscode.git"
    },
    "scripts": {
        "build": "tsc -p .",
        "bundle": "npm run clean && npm run build && vsce package",
        "publish": "npm run bundle && vsce publish",
        "clean": "rimraf --glob \"extension/*.js\" \"extension/*.js.map\" \"*.vsix\""
    },
    "author": "b1bu@users.noreply.github.com",
    "license": "MIT",
    "categories": [
        "Other"
    ],
    "keywords": [
        "source",
        "control",
        "button",
        "scm",
        "git",
        "push",
        "pull",
        "commit",
        "stage",
        "checkout",
        "discard",
        "stash",
        "tree",
        "list"
    ],
    "engines": {
        "vscode": "^1.44.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "*"
    ],
    "contributes": {
        "configuration": [
            {
                "title": "Button Visibility",
                "description": "Buttons to show in source control pane",
                "properties": {
                    "moreSourceControlButtons.enableGitCheckout": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.checkout`."
                    },
                    "moreSourceControlButtons.enableGitSync": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.sync`."
                    },
                    "moreSourceControlButtons.enableGitSyncRebase": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.syncRebase`."
                    },
                    "moreSourceControlButtons.enableGitPull": {
                        "type": "boolean",
                        "default": true,
                        "markdownDescription": "Show button for command `git.pull`."
                    },
                    "moreSourceControlButtons.enableGitPush": {
                        "type": "boolean",
                        "default": true,
                        "markdownDescription": "Show button for command `git.push`."
                    },
                    "moreSourceControlButtons.enableGitPullRebase": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.pullRebase`."
                    },
                    "moreSourceControlButtons.enableGitPushForce": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.pushForce`."
                    },
                    "moreSourceControlButtons.enableGitPullFrom": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.pullFrom`."
                    },
                    "moreSourceControlButtons.enableGitPushTo": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.pushTo`."
                    },
                    "moreSourceControlButtons.enableGitPublish": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.publish`."
                    },
                    "moreSourceControlButtons.enableGitCleanAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.cleanAll`."
                    },
                    "moreSourceControlButtons.enableGitStageAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stageAll`."
                    },
                    "moreSourceControlButtons.enableGitUnstageAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.unstageAll`."
                    },
                    "moreSourceControlButtons.enableGitCommitStaged": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitStaged`."
                    },
                    "moreSourceControlButtons.enableGitCommitAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitAll`."
                    },
                    "moreSourceControlButtons.enableGitCommitStagedAmend": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitStagedAmend`."
                    },
                    "moreSourceControlButtons.enableGitCommitAllAmend": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitAllAmend`."
                    },
                    "moreSourceControlButtons.enableGitCommitStagedSigned": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitStagedSigned`."
                    },
                    "moreSourceControlButtons.enableGitCommitAllSigned": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.commitAllSigned`."
                    },
                    "moreSourceControlButtons.enableGitUndoCommit": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.undoCommit`."
                    },
                    "moreSourceControlButtons.enableGitStashApplyLatest": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashApplyLatest`."
                    },
                    "moreSourceControlButtons.enableGitStashApply": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashApply`."
                    },
                    "moreSourceControlButtons.enableGitStashPopLatest": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashPopLatest`."
                    },
                    "moreSourceControlButtons.enableGitStashPop": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashPop`."
                    },
                    "moreSourceControlButtons.enableGitStash": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stash`."
                    },
                    "moreSourceControlButtons.enableGitStashIncludeUntracked": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashIncludeUntracked`."
                    },
                    "moreSourceControlButtons.enableGitStashStaged": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashStaged`."
                    },
                    "moreSourceControlButtons.enableGitStashDrop": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.stashDrop`."
                    },
                    "moreSourceControlButtons.enableGitShowOutput": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show button for command `git.showOutput`."
                    },
                    "moreSourceControlButtons.enableGitRefresh": {
                        "type": "boolean",
                        "default": true,
                        "markdownDescription": "Show button for command `git.refresh`."
                    }
                }
            },
            {
                "title": "Debug",
                "properties": {
                    "moreSourceControlButtons.enableAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show all buttons."
                    }
                }
            }
        ],
        "commands": [
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.checkout",
                "title": "Checkout to...",
                "icon": "$(git-commit)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.sync",
                "title": "Sync",
                "icon": "$(sync)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.syncRebase",
                "title": "Sync (Rebase)",
                "icon": "$(sync)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.pull",
                "title": "Pull",
                "icon": "$(repo-pull)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.push",
                "title": "Push",
                "icon": "$(repo-push)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.pullRebase",
                "title": "Pull (Rebase)",
                "icon": "$(repo-fetch)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.pushForce",
                "title": "Push (Force)",
                "icon": "$(repo-force-push)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.pullFrom",
                "title": "Pull from...",
                "icon": "$(cloud-download)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.pushTo",
                "title": "Push to...",
                "icon": "$(cloud-upload)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.publish",
                "title": "Publish branch...",
                "icon": "$(rocket)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.cleanAll",
                "title": "Discard All Changes",
                "icon": "$(discard)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stageAll",
                "title": "Stage All Changes",
                "icon": "$(add)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.unstageAll",
                "title": "Unstage All Changes",
                "icon": "$(remove)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.commitStaged",
                "title": "Commit Staged",
                "icon": "$(check)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.commitAll",
                "title": "Commit All",
                "icon": "$(check-all)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.commitStagedAmend",
                "title": "Commit Staged (Amend)",
                "icon": "$(check)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.commitAllAmend",
                "title": "Commit All (Amend)",
                "icon": "$(check-all)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.commitStagedSigned",
                "title": "Commit Staged (Signed Off)",
                "icon": "$(check)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.commitAllSigned",
                "title": "Commit All (Signed Off)",
                "icon": "$(check-all)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.undoCommit",
                "title": "Undo Commit",
                "icon": "$(reply)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stashApplyLatest",
                "title": "Apply Latest Stash",
                "icon": "$(git-stash-apply)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stashApply",
                "title": "Apply Stash...",
                "icon": "$(git-stash-apply)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stashPopLatest",
                "title": "Pop Latest Stash",
                "icon": "$(git-stash-pop)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stashPop",
                "title": "Pop Stash...",
                "icon": "$(git-stash-pop)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stash",
                "title": "Stash",
                "icon": "$(git-stash)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stashIncludeUntracked",
                "title": "Stash (Include Untracked)",
                "icon": "$(git-stash)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stashStaged",
                "title": "Stash Staged",
                "icon": "$(git-stash)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.stashDrop",
                "title": "Drop Stash...",
                "icon": "$(trash)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.showOutput",
                "title": "Show Git Output",
                "icon": "$(output)"
            },
            {
                "category": "Source Control Buttons",
                "command": "moreSourceControlButtons.git.refresh",
                "title": "Refresh",
                "icon": "$(refresh)"
            }
        ],
        "menus": {
            "scm/title": [
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCheckout) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.checkout",
                    "group": "navigation@1"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitSync) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.sync",
                    "group": "navigation@2"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitSyncRebase) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.syncRebase",
                    "group": "navigation@3"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPull) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.pull",
                    "group": "navigation@4"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPush) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.push",
                    "group": "navigation@5"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPullRebase) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.pullRebase",
                    "group": "navigation@6"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPushForce) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.pushForce",
                    "group": "navigation@7"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPullFrom) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.pullFrom",
                    "group": "navigation@8"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPushTo) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.pushTo",
                    "group": "navigation@9"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPublish) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.publish",
                    "group": "navigation@10"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCleanAll) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.cleanAll",
                    "group": "navigation@11"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStageAll) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stageAll",
                    "group": "navigation@12"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitUnstageAll) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.unstageAll",
                    "group": "navigation@13"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitStaged) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.commitStaged",
                    "group": "navigation@14"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitAll) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.commitAll",
                    "group": "navigation@15"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitStagedAmend) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.commitStagedAmend",
                    "group": "navigation@16"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitAllAmend) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.commitAllAmend",
                    "group": "navigation@17"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitStagedSigned) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.commitStagedSigned",
                    "group": "navigation@18"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitAllSigned) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.commitAllSigned",
                    "group": "navigation@19"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitUndoCommit) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.undoCommit",
                    "group": "navigation@20"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashApplyLatest) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stashApplyLatest",
                    "group": "navigation@21"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashApply) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stashApply",
                    "group": "navigation@22"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashPopLatest) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stashPopLatest",
                    "group": "navigation@23"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashPop) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stashPop",
                    "group": "navigation@24"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStash) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stash",
                    "group": "navigation@25"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashIncludeUntracked) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stashIncludeUntracked",
                    "group": "navigation@26"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashStaged) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stashStaged",
                    "group": "navigation@27"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashDrop) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.stashDrop",
                    "group": "navigation@28"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitShowOutput) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.showOutput",
                    "group": "navigation@29"
                },
                {
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitRefresh) && scmProvider == git",
                    "command": "moreSourceControlButtons.git.refresh",
                    "group": "navigation@30"
                }
            ]
        }
    },
    "devDependencies": {
        "@types/vscode": "^1.44.0",
        "rimraf": "^6.1.3",
        "typescript": "^3.9.7",
        "vsce": "^1.77.0"
    }
}