{
    "name": "more-scm-buttons",
    "publisher": "b1bu",
    "version": "1.0.0",
    "displayName": "More Source Control Buttons",
    "description": "Additional buttons for the Source Control panel",
    "icon": "resources/icon.png",
    "main": "extension/extension.js",
    "repository": {
        "type": "github",
        "url": "https://github.com/b1bu/scm-buttons-vscode.git"
    },
    "scripts": {
        "build": "tsc -p .",
        "bundle": "npm run clean && npm run build && vsce package",
        "publish": "npm run bundle && vsce publish",
        "clean": "rimraf --glob \"extension/*.js\" \"extension/*.js.map\" \"*.vsix\""
    },
    "author": "b1bu@users.noreply.github.com",
    "license": "MIT",
    "categories": [
        "Other"
    ],
    "keywords": [
        "source",
        "control",
        "button",
        "scm",
        "git",
        "push",
        "pull",
        "commit",
        "stage",
        "checkout",
        "discard",
        "stash",
        "tree",
        "list"
    ],
    "engines": {
        "vscode": "^1.44.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "*"
    ],
    "contributes": {
        "configuration": [
            {
                "id": "buttonVisibility",
                "title": "Button Visibility: General",
                "properties": {
                    "moreSourceControlButtons.enableGitCheckout": {
                        "markdownDescription": "Show button for command `Checkout to...`.",
                        "type": "boolean",
                        "default": true,
                        "order": 1
                    },
                    "moreSourceControlButtons.enableGitShowOutput": {
                        "markdownDescription": "Show button for command `Show Git Output`.",
                        "type": "boolean",
                        "default": false,
                        "order": 29
                    },
                    "moreSourceControlButtons.enableGitRefreshAlignedRight": {
                        "markdownDescription": "Show button for command `Refresh`. *(Aligned Right)*",
                        "type": "boolean",
                        "default": false,
                        "order": 30
                    }
                }
            },
            {
                "id": "buttonVisibilityChanges",
                "title": "Button Visibility: Changes",
                "properties": {
                    "moreSourceControlButtons.enableGitDiscardAllChanges": {
                        "markdownDescription": "Show button for command `Discard All Changes`.",
                        "type": "boolean",
                        "default": false,
                        "order": 11
                    },
                    "moreSourceControlButtons.enableGitStageAllChanges": {
                        "markdownDescription": "Show button for command `Stage All Changes`.",
                        "type": "boolean",
                        "default": false,
                        "order": 12
                    },
                    "moreSourceControlButtons.enableGitUnstageAllChanges": {
                        "markdownDescription": "Show button for command `Unstage All Changes`.",
                        "type": "boolean",
                        "default": false,
                        "order": 13
                    }
                }
            },
            {
                "id": "buttonVisibilityCommits",
                "title": "Button Visibility: Commits",
                "properties": {
                    "moreSourceControlButtons.enableGitCommitStaged": {
                        "markdownDescription": "Show button for command `Commit Staged`.",
                        "type": "boolean",
                        "default": false,
                        "order": 14
                    },
                    "moreSourceControlButtons.enableGitCommitAll": {
                        "markdownDescription": "Show button for command `Commit All`.",
                        "type": "boolean",
                        "default": false,
                        "order": 15
                    },
                    "moreSourceControlButtons.enableGitCommitStagedAmend": {
                        "markdownDescription": "Show button for command `Commit Staged (Amend)`.",
                        "type": "boolean",
                        "default": false,
                        "order": 16
                    },
                    "moreSourceControlButtons.enableGitCommitAllAmend": {
                        "markdownDescription": "Show button for command `Commit All (Amend)`.",
                        "type": "boolean",
                        "default": false,
                        "order": 17
                    },
                    "moreSourceControlButtons.enableGitCommitStagedSignedOff": {
                        "markdownDescription": "Show button for command `Commit Staged (Signed Off)`.",
                        "type": "boolean",
                        "default": false,
                        "order": 18
                    },
                    "moreSourceControlButtons.enableGitCommitAllSignedOff": {
                        "markdownDescription": "Show button for command `Commit All (Signed Off)`.",
                        "type": "boolean",
                        "default": false,
                        "order": 19
                    },
                    "moreSourceControlButtons.enableGitUndoCommit": {
                        "markdownDescription": "Show button for command `Undo Commit`.",
                        "type": "boolean",
                        "default": false,
                        "order": 20
                    }
                }
            },
            {
                "id": "buttonVisibilityRemotes",
                "title": "Button Visibility: Remotes",
                "properties": {
                    "moreSourceControlButtons.enableGitSync": {
                        "markdownDescription": "Show button for command `Sync`.",
                        "type": "boolean",
                        "default": false,
                        "order": 2
                    },
                    "moreSourceControlButtons.enableGitSyncRebase": {
                        "markdownDescription": "Show button for command `Sync (Rebase)`.",
                        "type": "boolean",
                        "default": false,
                        "order": 3
                    },
                    "moreSourceControlButtons.enableGitPull": {
                        "markdownDescription": "Show button for command `Pull`.",
                        "type": "boolean",
                        "default": true,
                        "order": 4
                    },
                    "moreSourceControlButtons.enableGitPush": {
                        "markdownDescription": "Show button for command `Push`.",
                        "type": "boolean",
                        "default": true,
                        "order": 5
                    },
                    "moreSourceControlButtons.enableGitPullRebase": {
                        "markdownDescription": "Show button for command `Pull (Rebase)`.",
                        "type": "boolean",
                        "default": false,
                        "order": 6
                    },
                    "moreSourceControlButtons.enableGitPushForce": {
                        "markdownDescription": "Show button for command `Push (Force)`.",
                        "type": "boolean",
                        "default": false,
                        "order": 7
                    },
                    "moreSourceControlButtons.enableGitPullFrom": {
                        "markdownDescription": "Show button for command `Pull from...`.",
                        "type": "boolean",
                        "default": false,
                        "order": 8
                    },
                    "moreSourceControlButtons.enableGitPushTo": {
                        "markdownDescription": "Show button for command `Push to...`.",
                        "type": "boolean",
                        "default": false,
                        "order": 9
                    },
                    "moreSourceControlButtons.enableGitPublishBranch": {
                        "markdownDescription": "Show button for command `Publish branch...`.",
                        "type": "boolean",
                        "default": false,
                        "order": 10
                    }
                }
            },
            {
                "id": "buttonVisibilityStashes",
                "title": "Button Visibility: Stashes",
                "properties": {
                    "moreSourceControlButtons.enableGitApplyLatestStash": {
                        "markdownDescription": "Show button for command `Apply Latest Stash`.",
                        "type": "boolean",
                        "default": false,
                        "order": 21
                    },
                    "moreSourceControlButtons.enableGitApplyStash": {
                        "markdownDescription": "Show button for command `Apply Stash...`.",
                        "type": "boolean",
                        "default": false,
                        "order": 22
                    },
                    "moreSourceControlButtons.enableGitPopLatestStash": {
                        "markdownDescription": "Show button for command `Pop Latest Stash`.",
                        "type": "boolean",
                        "default": false,
                        "order": 23
                    },
                    "moreSourceControlButtons.enableGitPopStash": {
                        "markdownDescription": "Show button for command `Pop Stash...`.",
                        "type": "boolean",
                        "default": false,
                        "order": 24
                    },
                    "moreSourceControlButtons.enableGitStash": {
                        "markdownDescription": "Show button for command `Stash`.",
                        "type": "boolean",
                        "default": false,
                        "order": 25
                    },
                    "moreSourceControlButtons.enableGitStashIncludeUntracked": {
                        "markdownDescription": "Show button for command `Stash (Include Untracked)`.",
                        "type": "boolean",
                        "default": false,
                        "order": 26
                    },
                    "moreSourceControlButtons.enableGitStashStaged": {
                        "markdownDescription": "Show button for command `Stash Staged`.",
                        "type": "boolean",
                        "default": false,
                        "order": 27
                    },
                    "moreSourceControlButtons.enableGitDropStash": {
                        "markdownDescription": "Show button for command `Drop Stash...`.",
                        "type": "boolean",
                        "default": false,
                        "order": 28
                    }
                }
            },
            {
                "title": "Debug",
                "properties": {
                    "moreSourceControlButtons.enableAll": {
                        "type": "boolean",
                        "default": false,
                        "markdownDescription": "Show all buttons."
                    }
                }
            }
        ],
        "commands": [
            {
                "category": "More Source Control Buttons",
                "title": "Checkout to...",
                "command": "more-scm-buttons.git.checkout",
                "icon": "$(git-commit)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Sync",
                "command": "more-scm-buttons.git.sync",
                "icon": "$(sync)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Sync (Rebase)",
                "command": "more-scm-buttons.git.syncRebase",
                "icon": "$(sync)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Pull",
                "command": "more-scm-buttons.git.pull",
                "icon": "$(repo-pull)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Push",
                "command": "more-scm-buttons.git.push",
                "icon": "$(repo-push)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Pull (Rebase)",
                "command": "more-scm-buttons.git.pullRebase",
                "icon": "$(repo-fetch)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Push (Force)",
                "command": "more-scm-buttons.git.pushForce",
                "icon": "$(repo-force-push)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Pull from...",
                "command": "more-scm-buttons.git.pullFrom",
                "icon": "$(cloud-download)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Push to...",
                "command": "more-scm-buttons.git.pushTo",
                "icon": "$(cloud-upload)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Publish branch...",
                "command": "more-scm-buttons.git.publish",
                "icon": "$(rocket)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Discard All Changes",
                "command": "more-scm-buttons.git.cleanAll",
                "icon": "$(discard)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Stage All Changes",
                "command": "more-scm-buttons.git.stageAll",
                "icon": "$(add)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Unstage All Changes",
                "command": "more-scm-buttons.git.unstageAll",
                "icon": "$(remove)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Commit Staged",
                "command": "more-scm-buttons.git.commitStaged",
                "icon": "$(check)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Commit All",
                "command": "more-scm-buttons.git.commitAll",
                "icon": "$(check-all)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Commit Staged (Amend)",
                "command": "more-scm-buttons.git.commitStagedAmend",
                "icon": "$(check)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Commit All (Amend)",
                "command": "more-scm-buttons.git.commitAllAmend",
                "icon": "$(check-all)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Commit Staged (Signed Off)",
                "command": "more-scm-buttons.git.commitStagedSigned",
                "icon": "$(check)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Commit All (Signed Off)",
                "command": "more-scm-buttons.git.commitAllSigned",
                "icon": "$(check-all)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Undo Commit",
                "command": "more-scm-buttons.git.undoCommit",
                "icon": "$(reply)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Apply Latest Stash",
                "command": "more-scm-buttons.git.stashApplyLatest",
                "icon": "$(git-stash-apply)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Apply Stash...",
                "command": "more-scm-buttons.git.stashApply",
                "icon": "$(git-stash-apply)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Pop Latest Stash",
                "command": "more-scm-buttons.git.stashPopLatest",
                "icon": "$(git-stash-pop)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Pop Stash...",
                "command": "more-scm-buttons.git.stashPop",
                "icon": "$(git-stash-pop)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Stash",
                "command": "more-scm-buttons.git.stash",
                "icon": "$(git-stash)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Stash (Include Untracked)",
                "command": "more-scm-buttons.git.stashIncludeUntracked",
                "icon": "$(git-stash)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Stash Staged",
                "command": "more-scm-buttons.git.stashStaged",
                "icon": "$(git-stash)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Drop Stash...",
                "command": "more-scm-buttons.git.stashDrop",
                "icon": "$(trash)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Show Git Output",
                "command": "more-scm-buttons.git.showOutput",
                "icon": "$(output)",
                "generated": true
            },
            {
                "category": "More Source Control Buttons",
                "title": "Refresh",
                "command": "more-scm-buttons.git.refresh",
                "icon": "$(refresh)",
                "generated": true
            }
        ],
        "menus": {
            "scm/title": [
                {
                    "command": "more-scm-buttons.git.checkout",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCheckout) && scmProvider == git",
                    "group": "navigation@1",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.sync",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitSync) && scmProvider == git",
                    "group": "navigation@2",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.syncRebase",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitSyncRebase) && scmProvider == git",
                    "group": "navigation@3",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.pull",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPull) && scmProvider == git",
                    "group": "navigation@4",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.push",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPush) && scmProvider == git",
                    "group": "navigation@5",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.pullRebase",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPullRebase) && scmProvider == git",
                    "group": "navigation@6",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.pushForce",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPushForce) && scmProvider == git",
                    "group": "navigation@7",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.pullFrom",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPullFrom) && scmProvider == git",
                    "group": "navigation@8",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.pushTo",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPushTo) && scmProvider == git",
                    "group": "navigation@9",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.publish",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPublishBranch) && scmProvider == git",
                    "group": "navigation@10",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.cleanAll",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitDiscardAllChanges) && scmProvider == git",
                    "group": "navigation@11",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stageAll",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStageAllChanges) && scmProvider == git",
                    "group": "navigation@12",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.unstageAll",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitUnstageAllChanges) && scmProvider == git",
                    "group": "navigation@13",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.commitStaged",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitStaged) && scmProvider == git",
                    "group": "navigation@14",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.commitAll",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitAll) && scmProvider == git",
                    "group": "navigation@15",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.commitStagedAmend",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitStagedAmend) && scmProvider == git",
                    "group": "navigation@16",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.commitAllAmend",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitAllAmend) && scmProvider == git",
                    "group": "navigation@17",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.commitStagedSigned",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitStagedSignedOff) && scmProvider == git",
                    "group": "navigation@18",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.commitAllSigned",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitCommitAllSignedOff) && scmProvider == git",
                    "group": "navigation@19",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.undoCommit",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitUndoCommit) && scmProvider == git",
                    "group": "navigation@20",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stashApplyLatest",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitApplyLatestStash) && scmProvider == git",
                    "group": "navigation@21",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stashApply",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitApplyStash) && scmProvider == git",
                    "group": "navigation@22",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stashPopLatest",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPopLatestStash) && scmProvider == git",
                    "group": "navigation@23",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stashPop",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitPopStash) && scmProvider == git",
                    "group": "navigation@24",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stash",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStash) && scmProvider == git",
                    "group": "navigation@25",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stashIncludeUntracked",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashIncludeUntracked) && scmProvider == git",
                    "group": "navigation@26",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stashStaged",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitStashStaged) && scmProvider == git",
                    "group": "navigation@27",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.stashDrop",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitDropStash) && scmProvider == git",
                    "group": "navigation@28",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.showOutput",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitShowOutput) && scmProvider == git",
                    "group": "navigation@29",
                    "generated": true
                },
                {
                    "command": "more-scm-buttons.git.refresh",
                    "when": "(config.moreSourceControlButtons.enableAll || config.moreSourceControlButtons.enableGitRefreshAlignedRight) && scmProvider == git",
                    "group": "navigation@30",
                    "generated": true
                }
            ]
        }
    },
    "devDependencies": {
        "@types/vscode": "^1.44.0",
        "@vscode/vsce": "^3.9.2",
        "rimraf": "^6.1.3",
        "typescript": "^3.9.7"
    }
}